    <!--
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Bot Individuals (ABox) — Cancer Care Continuum (6 instances)
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    <!-- http://www.IoB.org/ontologies/botprofile#PrimaryCareBot -->

    <owl:NamedIndividual rdf:about="http://www.IoB.org/ontologies/botprofile#PrimaryCareBot">
        <rdf:type rdf:resource="http://www.IoB.org/ontologies/botprofile#InformationalBot"/>
        <bp:botID>bot-cc-001</bp:botID>
        <bp:name>PrimaryCareBot</bp:name>
        <bp:domain>e-health</bp:domain>
        <bp:hasTechnology rdf:resource="http://www.IoB.org/ontologies/botprofile#NarrowAI"/>
        <bp:capabilityLevel>query, collect, share, notify</bp:capabilityLevel>
        <bp:hasAutonomy rdf:resource="http://www.IoB.org/ontologies/botprofile#PartiallyAutomated"/>
        <bp:hasInteraction rdf:resource="http://www.IoB.org/ontologies/botprofile#MultimodalMode"/>
        <bp:hasCommunicationStyle rdf:resource="http://www.IoB.org/ontologies/botprofile#HumanToBot"/>
        <bp:hasCommunicationStyle rdf:resource="http://www.IoB.org/ontologies/botprofile#BotToBot"/>
        <bp:authLevel>Internal</bp:authLevel>
        <bp:dataSensitivity rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</bp:dataSensitivity>
        <bp:ontologiesUsed rdf:resource="http://www.IoB.org/ontologies/botprofile#HL7_FHIR"/>
        <bp:ontologiesUsed rdf:resource="http://www.IoB.org/ontologies/botprofile#SNOMED_CT"/>
        <bp:protocolsSupported rdf:resource="http://www.IoB.org/ontologies/botprofile#REST_protocol"/>
        <bp:protocolsSupported rdf:resource="http://www.IoB.org/ontologies/botprofile#HTTP_protocol"/>
        <rdfs:label>Bot 1 : Primary Care Bot</rdfs:label>
        <rdfs:comment>Informational bot responsible for gathering patient identity, symptoms, medical history, and insurance details. Acts as the entry point of the cancer care journey, interacting directly with the patient (H2B) and forwarding structured data to Bot 2 (B2B).</rdfs:comment>
    </owl:NamedIndividual>


    <!-- http://www.IoB.org/ontologies/botprofile#SpecialistCoordinationBot -->

    <owl:NamedIndividual rdf:about="http://www.IoB.org/ontologies/botprofile#SpecialistCoordinationBot">
        <rdf:type rdf:resource="http://www.IoB.org/ontologies/botprofile#TaskOrientedBot"/>
        <bp:botID>bot-cc-002</bp:botID>
        <bp:name>SpecialistCoordinationBot</bp:name>
        <bp:domain>e-health</bp:domain>
        <bp:hasTechnology rdf:resource="http://www.IoB.org/ontologies/botprofile#FoundationModelAI"/>
        <bp:capabilityLevel>schedule, delegate, execute, notify, transfer</bp:capabilityLevel>
        <bp:hasAutonomy rdf:resource="http://www.IoB.org/ontologies/botprofile#FullyAutomated"/>
        <bp:hasInteraction rdf:resource="http://www.IoB.org/ontologies/botprofile#CommandAndControl"/>
        <bp:hasCommunicationStyle rdf:resource="http://www.IoB.org/ontologies/botprofile#BotToBot"/>
        <bp:hasCommunicationStyle rdf:resource="http://www.IoB.org/ontologies/botprofile#BotToService"/>
        <bp:authLevel>Restricted</bp:authLevel>
        <bp:dataSensitivity rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</bp:dataSensitivity>
        <bp:ontologiesUsed rdf:resource="http://www.IoB.org/ontologies/botprofile#HL7_FHIR"/>
        <bp:ontologiesUsed rdf:resource="http://www.IoB.org/ontologies/botprofile#ICD_10"/>
        <bp:protocolsSupported rdf:resource="http://www.IoB.org/ontologies/botprofile#REST_protocol"/>
        <bp:protocolsSupported rdf:resource="http://www.IoB.org/ontologies/botprofile#gRPC_protocol"/>
        <bp:protocolsSupported rdf:resource="http://www.IoB.org/ontologies/botprofile#FIPA_ACL_protocol"/>
        <rdfs:label>Bot 2 : Specialist Coordination Bot</rdfs:label>
        <rdfs:comment>Ensures bot collaboration; schedules appointments; arranges diagnostics (MRI, biopsy); improves clinician flow.</rdfs:comment>
    </owl:NamedIndividual>


    <!-- http://www.IoB.org/ontologies/botprofile#HealthInsuranceBot -->

    <owl:NamedIndividual rdf:about="http://www.IoB.org/ontologies/botprofile#HealthInsuranceBot">
