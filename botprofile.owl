<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.IoB.org/ontologies/botprofile#"
     xml:base="http://www.IoB.org/ontologies/botprofile"
     xmlns:bp="http://www.IoB.org/ontologies/botprofile#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
    <owl:Ontology rdf:about="http://www.IoB.org/ontologies/botprofile">
        <rdfs:label>IoB Bot Profile Ontology</rdfs:label>
        <rdfs:comment>Internet of Bots Bot Profile Ontology. TBox + ABox instantiation for the cancer care continuum use case (6 bot individuals). Supports SPARQL competency questions CQ1-CQ4 (Section 5.4 of the paper).</rdfs:comment>
    </owl:Ontology>


    <!--
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    <!-- http://www.IoB.org/ontologies/botprofile#hasAutonomy -->

    <owl:ObjectProperty rdf:about="http://www.IoB.org/ontologies/botprofile#hasAutonomy">
        <rdfs:domain rdf:resource="http://www.IoB.org/ontologies/botprofile#Bot"/>
        <rdfs:range rdf:resource="http://www.IoB.org/ontologies/botprofile#AutonomyLevel"/>
    </owl:ObjectProperty>


    <!-- http://www.IoB.org/ontologies/botprofile#hasCommunicationStyle -->

    <owl:ObjectProperty rdf:about="http://www.IoB.org/ontologies/botprofile#hasCommunicationStyle">
        <rdfs:domain rdf:resource="http://www.IoB.org/ontologies/botprofile#Bot"/>
        <rdfs:range rdf:resource="http://www.IoB.org/ontologies/botprofile#CommunicationStyle"/>
    </owl:ObjectProperty>


    <!-- http://www.IoB.org/ontologies/botprofile#hasInteraction -->

    <owl:ObjectProperty rdf:about="http://www.IoB.org/ontologies/botprofile#hasInteraction">
        <rdfs:domain rdf:resource="http://www.IoB.org/ontologies/botprofile#Bot"/>
        <rdfs:range rdf:resource="http://www.IoB.org/ontologies/botprofile#InteractionMode"/>
    </owl:ObjectProperty>


    <!-- http://www.IoB.org/ontologies/botprofile#hasTechnology -->

    <owl:ObjectProperty rdf:about="http://www.IoB.org/ontologies/botprofile#hasTechnology">
        <rdfs:domain rdf:resource="http://www.IoB.org/ontologies/botprofile#Bot"/>
        <rdfs:range rdf:resource="http://www.IoB.org/ontologies/botprofile#Technology"/>
    </owl:ObjectProperty>


    <!-- http://www.IoB.org/ontologies/botprofile#ontologiesUsed -->

    <owl:ObjectProperty rdf:about="http://www.IoB.org/ontologies/botprofile#ontologiesUsed">
        <rdfs:domain rdf:resource="http://www.IoB.org/ontologies/botprofile#Bot"/>
        <rdfs:range rdf:resource="http://www.IoB.org/ontologies/botprofile#Ontology"/>
    </owl:ObjectProperty>


    <!-- http://www.IoB.org/ontologies/botprofile#protocolsSupported -->

    <owl:ObjectProperty rdf:about="http://www.IoB.org/ontologies/botprofile#protocolsSupported">
        <rdfs:domain rdf:resource="http://www.IoB.org/ontologies/botprofile#Bot"/>
        <rdfs:range rdf:resource="http://www.IoB.org/ontologies/botprofile#CommunicationProtocol"/>
    </owl:ObjectProperty>


    <!--
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    <!-- http://www.IoB.org/ontologies/botprofile#authLevel -->
    <!-- Note: defined as DatatypeProperty (xsd:string) so that SPARQL queries
         CQ2 and CQ4 using literal filters ("Restricted", "Internal") execute correctly. -->

    <owl:DatatypeProperty rdf:about="http://www.IoB.org/ontologies/botprofile#authLevel">
        <rdfs:domain rdf:resource="http://www.IoB.org/ontologies/botprofile#Bot"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>


    <!-- http://www.IoB.org/ontologies/botprofile#botID -->

    <owl:DatatypeProperty rdf:about="http://www.IoB.org/ontologies/botprofile#botID">
        <rdfs:domain rdf:resource="http://www.IoB.org/ontologies/botprofile#Bot"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>


    <!-- http://www.IoB.org/ontologies/botprofile#capabilityLevel -->

    <owl:DatatypeProperty rdf:about="http://www.IoB.org/ontologies/botprofile#capabilityLevel">
        <rdfs:domain rdf:resource="http://www.IoB.org/ontologies/botprofile#Bot"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>


    <!-- http://www.IoB.org/ontologies/botprofile#dataSensitivity -->

    <owl:DatatypeProperty rdf:about="http://www.IoB.org/ontologies/botprofile#dataSensitivity">
        <rdfs:domain rdf:resource="http://www.IoB.org/ontologies/botprofile#Bot"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    </owl:DatatypeProperty>


    <!-- http://www.IoB.org/ontologies/botprofile#domain -->

    <owl:DatatypeProperty rdf:about="http://www.IoB.org/ontologies/botprofile#domain">
        <rdfs:domain rdf:resource="http://www.IoB.org/ontologies/botprofile#Bot"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>


    <!-- http://www.IoB.org/ontologies/botprofile#name -->

    <owl:DatatypeProperty rdf:about="http://www.IoB.org/ontologies/botprofile#name">
        <rdfs:domain rdf:resource="http://www.IoB.org/ontologies/botprofile#Bot"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>


    <!-- http://www.IoB.org/ontologies/botprofile#provider -->

    <owl:DatatypeProperty rdf:about="http://www.IoB.org/ontologies/botprofile#provider">
        <rdfs:domain rdf:resource="http://www.IoB.org/ontologies/botprofile#Bot"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>


