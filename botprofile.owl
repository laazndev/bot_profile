        <bp:protocolsSupported rdf:resource="http://www.IoB.org/ontologies/botprofile#HTTP_protocol"/>
        <rdfs:label>Bot 3 : Health Insurance Bot</rdfs:label>
        <rdfs:comment>Validates insurance coverage; applies rules to confirm or deny eligibility; notifies coordination bot and patient.</rdfs:comment>
    </owl:NamedIndividual>


    <!-- http://www.IoB.org/ontologies/botprofile#TreatmentProgrammerBot -->

    <owl:NamedIndividual rdf:about="http://www.IoB.org/ontologies/botprofile#TreatmentProgrammerBot">
